# Copy to .env.local for local development. Placeholders only â€” never commit real values.
# In Vercel, set the same variables under Project â†’ Settings â†’ Environment Variables.

# Public (safe for the browser). Supabase Dashboard â†’ Project Settings â†’ API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-key

# Server only â€” Supabase Dashboard â†’ Project Settings â†’ API Keys â†’ Secret keys.
# Mark it "Sensitive" in Vercel. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-key

# Server only â€” at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a different value per environment. Rotating it signs out every student.
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Used only by the local administrator script (npm run setup:admin).
ADMIN_EMAIL=teacher@example.com

# Not used by the deployed application. Only for applying migrations with psql.
# DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Browser tests against a running deployment only (never set in Vercel).
# E2E_BASE_URL=https://your-deployment.vercel.app
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
