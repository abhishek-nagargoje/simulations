{
  "name": "hr-remedy-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "setup:admin": "node --env-file=.env.local scripts/setup-admin.mjs",
    "import:sap": "node --env-file-if-exists=.env.local scripts/import-sap-data/index.mjs",
    "build:sap": "node scripts/build-sap-module.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "test:stack": "playwright test -c playwright.stack.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "check:setup": "node --env-file=.env.local scripts/check-setup.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "exceljs": "^4.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
